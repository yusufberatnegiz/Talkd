{
  "cli": {
    "version": ">= 21.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "distribution": "internal"
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_ENABLE_SENTRY": "true",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
